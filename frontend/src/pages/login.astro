---
import PublicLayout from '../layouts/PublicLayout.astro';
import Brand from '../components/layout/Brand.astro';
---
<PublicLayout title="Acceso | Refugio">
  <main class="grid min-h-screen bg-cream lg:grid-cols-[.9fr_1.1fr]">
    <section class="relative hidden overflow-hidden bg-teal-900 p-12 text-white lg:flex lg:flex-col lg:justify-between"><img src="/images/cat-card.jpg" alt="Gato en un refugio" class="absolute inset-0 h-full w-full object-cover opacity-25" /><div class="absolute inset-0 bg-teal-950/60"></div><div class="relative"><Brand light /><p class="mt-28 max-w-md text-sm font-bold uppercase tracking-[.2em] text-yellow-300">Panel de cuidado</p><h1 class="display-text mt-5 max-w-lg text-7xl leading-[.9]">Cada registro cuenta una historia.</h1></div><p class="relative max-w-sm text-sm leading-6 text-white/60">Administra los animales del refugio y ayuda a que cada historia encuentre su siguiente capítulo.</p></section>
    <section class="flex items-center justify-center px-6 py-12 sm:px-12"><div class="w-full max-w-md"><div class="mb-14 lg:hidden"><Brand /></div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-teal-800">Bienvenido de vuelta</p><h2 class="display-text mt-3 text-5xl leading-none text-teal-950">Entra al refugio.</h2><p class="mt-5 text-sm leading-6 text-teal-900/60">Usa tus credenciales de administrador para continuar.</p><form id="login-form" class="mt-9 space-y-5"><div id="login-error" class="hidden rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></div><label class="block text-sm font-extrabold text-teal-950">Usuario<input name="usuario" autocomplete="username" placeholder="Tu usuario" class="focus-ring mt-2 w-full rounded-2xl border border-teal-900/10 bg-white px-4 py-3.5 outline-none transition focus:border-teal-800" /></label><label class="block text-sm font-extrabold text-teal-950">Contraseña<input name="contrasena" type="password" autocomplete="current-password" placeholder="Tu contraseña" class="focus-ring mt-2 w-full rounded-2xl border border-teal-900/10 bg-white px-4 py-3.5 outline-none transition focus:border-teal-800" /></label><button id="login-submit" type="submit" class="focus-ring w-full rounded-full bg-yellow-400 px-6 py-4 text-sm font-extrabold text-teal-950 transition hover:bg-yellow-300">Entrar al refugio</button></form><a href="/" class="focus-ring mt-8 inline-block text-sm font-bold text-teal-800/65 hover:text-teal-950">← Volver al inicio</a></div></section>
  </main>
  <script>import '../scripts/login';</script>
</PublicLayout>
