---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import AnimalForm from '../../../components/animals/AnimalForm.astro';
---
<DashboardLayout><div class="mx-auto max-w-3xl px-5 py-8 sm:px-8 lg:px-12 lg:py-14"><a href="/dashboard" class="focus-ring text-sm font-bold text-teal-800/65 hover:text-teal-950">← Volver a animales</a><p class="mt-12 text-xs font-extrabold uppercase tracking-[.2em] text-teal-800">Actualizar historia</p><h1 class="display-text mt-2 text-5xl leading-none text-teal-950">Editar animal.</h1><p class="mt-4 text-sm leading-6 text-teal-900/55">Mantén sus datos al día para acompañarlo mejor.</p><div class="mt-9 rounded-[2rem] bg-white p-6 shadow-sm sm:p-9"><AnimalForm mode="edit" /></div></div><script>import '../../../scripts/animal-form';</script></DashboardLayout>
