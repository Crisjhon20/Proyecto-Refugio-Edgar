---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout>
  <div class="mx-auto max-w-7xl px-5 py-6 sm:px-8 lg:px-12 lg:py-10">
    <header class="flex items-end justify-between gap-4"><div><p class="text-xs font-extrabold uppercase tracking-[.2em] text-teal-800">Panel de cuidado</p><h1 class="display-text mt-2 text-5xl leading-none text-teal-950 sm:text-6xl">Tus historias.</h1><p class="mt-4 text-sm text-teal-900/55">Gestiona los animales que esperan una nueva familia.</p></div><a href="/dashboard/animals/new" class="focus-ring hidden rounded-full bg-yellow-400 px-5 py-3 text-sm font-extrabold text-teal-950 transition hover:bg-yellow-300 sm:inline-flex">+ Registrar animal</a></header>
    <a href="/dashboard/animals/new" class="focus-ring mt-7 inline-flex rounded-full bg-yellow-400 px-5 py-3 text-sm font-extrabold text-teal-950 sm:hidden">+ Registrar animal</a>
    <section class="mt-10 rounded-[2rem] bg-teal-950 p-5 text-white sm:p-7"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-yellow-300">Tu refugio hoy</p><p id="animal-count" class="mt-2 text-2xl font-extrabold">Cargando...</p></div><form id="filter-form" class="grid w-full gap-2 sm:w-auto sm:grid-cols-2 lg:grid-cols-4"><input name="nombre" placeholder="Buscar nombre" class="focus-ring rounded-xl border-0 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/45 outline-none" /><input name="raza" placeholder="Buscar raza" class="focus-ring rounded-xl border-0 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/45 outline-none" /><select name="sexo" class="focus-ring rounded-xl border-0 bg-white/10 px-3 py-2 text-sm text-white outline-none"><option value="">Cualquier sexo</option><option>Hembra</option><option>Macho</option></select><select name="tipoAnimal" class="focus-ring rounded-xl border-0 bg-white/10 px-3 py-2 text-sm text-white outline-none"><option value="">Perros y gatos</option><option>Perro</option><option>Gato</option></select><button class="focus-ring rounded-xl bg-yellow-400 px-4 py-2 text-sm font-extrabold text-teal-950 hover:bg-yellow-300 sm:col-span-2 lg:col-span-4">Aplicar filtros</button></form></div></section>
    <div id="animal-error" class="mt-5 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></div>
    <section id="animal-grid" class="mt-7 grid gap-5 sm:grid-cols-2 xl:grid-cols-3"><p class="col-span-full py-16 text-center text-sm font-bold text-teal-900/50">Cargando historias...</p></section>
    <div id="animal-empty" class="mt-7 hidden rounded-[2rem] border border-dashed border-teal-900/15 bg-white px-6 py-16 text-center"><p class="text-4xl">✦</p><h2 class="display-text mt-4 text-3xl text-teal-950">Aun no hay coincidencias.</h2><p class="mt-2 text-sm text-teal-900/55">Prueba con otros filtros o registra un nuevo animal.</p></div>
  </div>
  <script>import '../../scripts/dashboard';</script>
</DashboardLayout>
